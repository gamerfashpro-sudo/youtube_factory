# Copy this file to ".env" and fill in values you need.
# ".env" is ignored by git. Never commit real keys.
#
# Version 0.1.0 makes no network requests, so every variable below is optional
# and reserved for future integrations. Windows environment variables take
# priority over this file. Empty values count as "not set".

# --- YouTube Data API (planned: video title, channel, duration, thumbnail) ---
# Create a key in Google Cloud Console and enable "YouTube Data API v3".
YOUTUBE_API_KEY=

# --- Transcript extraction service (planned) ---
# Name of the provider adapter to use, for example: youtube-captions
TRANSCRIPT_PROVIDER=
# API key for the provider, if it needs one.
TRANSCRIPT_API_KEY=

# --- Language model for refining Shorts (planned, local or cloud) ---
# Provider name, for example: openai-compatible, ollama
LLM_PROVIDER=
# API key for cloud providers. Leave empty for a local model.
LLM_API_KEY=
# Base URL of an OpenAI-compatible endpoint, for example http://localhost:11434/v1
LLM_BASE_URL=
# Model name, for example: llama3.1
LLM_MODEL=

# --- Development only ---
# Override the folder used for history, settings and logs.
# YOUTUBE_FACTORY_DATA_DIR=C:\Temp\yf-data
